# Gmail example: use a Google App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your-business-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
CONTACT_RECIPIENT=your-business-email@gmail.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_API_KEY=generate-a-long-random-admin-key
